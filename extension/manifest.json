{
  "manifest_version": 3,
  "name": "Canvas Local Archive",
  "version": "1.0.1",
  "description": "Select Canvas materials and save them in a real folder for each course.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://canvas.calpoly.edu/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "script/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Canvas Local Archive"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "key": ""
}
